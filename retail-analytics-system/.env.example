# Copiar a la raíz del proyecto como .env (docker compose lo lee automáticamente).
# Fuente de video: archivo local montado en /data, RTSP o índice de webcam.
VIDEO_SOURCE=/data/sample.mp4
# VIDEO_SOURCE=rtsp://usuario:clave@192.168.1.64:554/Streaming/Channels/101
VISION_MODE=auto
CAMERA_ID=cam-01
CAMERA_NAME=Caja principal
TIMEZONE=America/Argentina/Buenos_Aires
PROCESS_FPS=8
YOLO_DEVICE=cpu
QUEUE_CAPACITY=8
QUEUE_TARGET_WAIT_S=180
MAX_OCCUPANCY=40
ACCUMULATION_ALERT_THRESHOLD=75
SEED_DEMO_HISTORY=true
POSTGRES_PASSWORD=retail
